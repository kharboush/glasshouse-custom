+// The G6 setting adds its layout only while on, including the Guide's place.
+async function visitHomeG6Layout(browser, base, problems) {
+  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });
+  const layout = { rows: ['app', 'dev', 'ch', 'iptv'], order: { app: [], dev: [], ch: [], iptv: [] },
+    hidden: { app: [], dev: [], ch: [], iptv: [] }, channels: ['broadcast'], hintSeen: true, searchHintSeen: true,
+    g6CustomLayout: false, view: 'standard', livePreview: false };
+  let version = 1;
+  await page.route('**/api/home/**', route => {
+    const url = new URL(route.request().url());
+    const reply = body => route.fulfill({ json: body });
+    if (url.pathname.endsWith('/catalogue')) return reply({ ok: true, layout, layoutVersion: version,
+      apps: [{ id: 'app', title: 'App' }], devices: [{ id: 'player', name: 'Player', port: 1 }],
+      channels: [{ id: 'broadcast', name: 'Broadcast', number: '1' }],
+      iptv: [{ id: 'internet', name: 'Internet', pl: 'playlist', key: 'internet' }], iptvStatus: { lineup: 1 },
+      sources: { channels: 1, iptv: 1 },
+      order: { app: ['app'], dev: ['player'], ch: ['broadcast'], iptv: ['internet'] } });
+    return reply({ ok: true, build: 'g6-layout', layoutVersion: version });
+  });
+  async function changeLayout(change) {
+    Object.assign(layout, change);
+    version++;
+    const updated = page.waitForResponse(r => new URL(r.url()).pathname === '/api/home/catalogue');
+    await page.clock.fastForward(5000);
+    await updated;
+    await page.waitForTimeout(100);
+  }
+  async function geometry() {
+    return page.evaluate(() => {
+      const css = id => getComputedStyle(document.getElementById(id));
+      const size = selector => {
+        const r = document.querySelector(selector).getBoundingClientRect();
+        return [r.width, r.height];
+      };
+      return { now: [parseFloat(css('now').height), parseFloat(css('now').paddingTop), css('now').alignItems],
+        clock: parseFloat(css('clock').fontSize), title: parseFloat(css('srcTitle').fontSize),
+        preview: [parseFloat(css('preview').width), parseFloat(css('preview').height)],
+        note: parseFloat(css('pvNote').lineHeight), rows: parseFloat(css('rows').top),
+        dev: size('.tile.dev'), tv: size('.tile.ch.tv'), broadcast: size('.row[data-key="ch"] .tile.ch'),
+        guide: Array.from(document.querySelectorAll('.row[data-key="iptv"] .tile .nm')).map(el => el.textContent),
+        on: document.getElementById('stage').classList.contains('g6-custom') };
+    });
+  }
+  function expect(actual, expected, label) {
+    if (JSON.stringify(actual) !== JSON.stringify(expected)) problems.push('Home G6 layout: ' + label + ': ' + JSON.stringify(actual));
+  }
+  try {
+    await page.clock.install();
+    await page.goto(base + '/assets/home.html');
+    await page.waitForSelector('.tile.ch.tv');
+    let g = await geometry();
+    expect([g.now, g.clock, g.title, g.preview, g.note, g.rows, g.dev, g.tv, g.broadcast, g.guide, g.on],
+      [[262, 0, 'flex-end'], 176, 70, [356, 200], 200, 296, [470, 124], [224, 176], [224, 176], ['Internet', 'Guide'], false], 'stock when off');
+    await changeLayout({ g6CustomLayout: true });
+    g = await geometry();
+    expect([g.now, g.clock, g.title, g.preview, g.note, g.rows, g.dev, g.tv, g.broadcast, g.guide, g.on],
+      [[602, 62, 'flex-start'], 48, 32, [864, 486], 486, 696, [384, 216], [384, 216], [224, 176], ['Guide', 'Internet'], true], 'additive overrides when on');
+    await changeLayout({ view: 'alternative' });
+    g = await geometry();
+    expect([g.clock, g.dev], [100, [420, 108]], 'Alternative View keeps its own clock and input tiles');
+    await changeLayout({ view: 'standard', g6CustomLayout: false });
+    g = await geometry();
+    expect([g.now, g.clock, g.title, g.preview, g.note, g.rows, g.dev, g.tv, g.broadcast, g.guide, g.on],
+      [[262, 0, 'flex-end'], 176, 70, [356, 200], 200, 296, [470, 124], [224, 176], [224, 176], ['Internet', 'Guide'], false], 'stock again when switched off');
+  } catch (e) {
+    problems.push('Home G6 layout: ' + e.message);
+  }
+  await page.close();
+}
